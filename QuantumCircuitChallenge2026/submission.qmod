qfunc main(output x: qbit[6], output y: qbit[6]) {
  allocate(6, x);
  allocate(6, y);
  hadamard_transform(x);
  hadamard_transform(y);
  control (x[5] == 1) {
    control (y[4] == 0) {
      control (y[2] == 1) {
        control (y[5] == 1) {
          control (x[4] == 1) {
            phase (pi);
            control (y[1] == 1) {
              control (y[0] == 1) {
                control (x[1] == 1) {
                  control (((x[2] == 1) & (y[3] == 0)) & (x[3] == 1)) {
                    phase (pi);
                  }
                  control (x[2] == 0) {
                    phase (pi);
                  }
                }
                control ((((x[0] == 0) & (x[2] == 1)) & (x[3] == 0)) & (x[1] == 0)) {
                  phase (pi);
                }
                control ((x[2] == 0) & (y[3] == 0)) {
                  phase (pi);
                }
              }
              control (((((x[1] == 1) & (x[2] == 0)) & (y[0] == 0)) & (x[3] == 0)) & (x[0] == 0)) {
                phase (pi);
              }
            }
            control (x[0] == 0) {
              control (y[0] == 0) {
                control (y[3] == 0) {
                  control (((x[1] == 1) & (x[2] == 0)) & (x[3] == 0)) {
                    phase (pi);
                  }
                  control (((x[2] == 1) & (x[3] == 1)) & (x[1] == 0)) {
                    phase (pi);
                  }
                }
              }
              control ((((x[2] == 1) & (y[1] == 0)) & (x[3] == 1)) & (x[1] == 0)) {
                phase (pi);
              }
            }
            control (((x[2] == 0) & (x[3] == 0)) & (x[1] == 0)) {
              phase (pi);
            }
          }
          control ((((x[4] == 0) & (y[3] == 0)) & (y[0] == 1)) & (y[1] == 1)) {
            phase (pi);
          }
        }
        control (y[3] == 1) {
          control (y[5] == 0) {
            control (x[4] == 0) {
              phase (pi);
              control (x[1] == 1) {
                control (x[2] == 1) {
                  control (x[0] == 1) {
                    control (x[3] == 1) {
                      phase (pi);
                      control ((y[0] == 1) & (y[1] == 1)) {
                        phase (pi);
                      }
                    }
                  }
                  control ((y[0] == 0) & (y[1] == 0)) {
                    phase (pi);
                  }
                }
                control (((y[0] == 0) & (x[3] == 0)) & (y[1] == 0)) {
                  phase (pi);
                }
              }
              control (x[0] == 1) {
                control ((((y[1] == 0) & (x[2] == 1)) & (y[0] == 0)) & (x[3] == 1)) {
                  phase (pi);
                }
                control (((((y[0] == 1) & (x[1] == 0)) & (y[1] == 1)) & (x[2] == 0)) & (x[3] == 0)) {
                  phase (pi);
                }
              }
            }
          }
        }
      }
      control (y[5] == 1) {
        control (x[4] == 1) {
          control (y[0] == 1) {
            control (y[1] == 1) {
              control (y[3] == 0) {
                control (x[1] == 0) {
                  control ((x[2] == 0) & (x[3] == 1)) {
                    phase (pi);
                  }
                  control (((x[0] == 0) & (x[2] == 1)) & (x[3] == 0)) {
                    phase (pi);
                  }
                }
                control (((y[2] == 0) & (x[2] == 1)) & (x[3] == 0)) {
                  phase (pi);
                }
              }
            }
          }
          control (((((x[1] == 1) & (x[2] == 1)) & (x[3] == 1)) & (y[3] == 1)) & (y[2] == 0)) {
            phase (pi);
          }
        }
        control ((y[2] == 0) & (y[3] == 1)) {
          phase (pi);
        }
      }
      control (y[1] == 1) {
        control (y[5] == 0) {
          control (y[3] == 1) {
            control (x[4] == 0) {
              control (y[2] == 0) {
                control ((((x[1] == 1) & (x[2] == 1)) & (y[0] == 0)) & (x[3] == 0)) {
                  phase (pi);
                }
                control (((x[2] == 0) & (y[0] == 1)) & (x[3] == 1)) {
                  phase (pi);
                }
              }
            }
          }
        }
      }
    }
    control (y[5] == 0) {
      control (y[4] == 1) {
        control (x[4] == 0) {
          control (y[3] == 1) {
            control (y[2] == 0) {
              control (x[2] == 1) {
                control (x[1] == 0) {
                  control (y[0] == 0) {
                    control (y[1] == 1) {
                      phase (pi);
                      control ((x[0] == 1) & (x[3] == 1)) {

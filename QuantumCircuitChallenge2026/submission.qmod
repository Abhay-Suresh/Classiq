        }
      }
      control (y[3] == 1) {
        control (x[4] == 0) {
          control (x[2] == 0) {
            control (((y[2] == 1) & (x[3] == 0)) & (x[1] == 0)) {
              phase (pi);
            }
            control ((((((x[1] == 1) & (y[0] == 1)) & (x[0] == 1)) & (x[3] == 1)) & (y[1] == 1)) & (y[2] == 0)) {

                      }
                    }
                  }
                }
                control ((((x[1] == 1) & (y[1] == 0)) & (x[0] == 1)) & (x[3] == 1)) {
                  phase (pi);
                }
              }
              control (x[2] == 0) {
                control (((x[3] == 0) & (y[1] == 0)) & (x[1] == 0)) {

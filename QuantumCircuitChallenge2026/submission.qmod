qperm logo_phase_oracle(const x: qnum, const y: qnum) {
  control ((((x >= 2) & (x <= 61)) & (y >= 39)) & (y <= 43)) {
    phase (pi);
  }
  control ((((x >= 2) & (x <= 26)) & (y >= 29)) & (y <= 38)) {
    phase (pi);
  }
  control ((((x >= 2) & (x <= 26)) & (y >= 44)) & (y <= 53)) {
    phase (pi);
  }
  control (((y >= 17) & (y <= 21)) & ((x >= 32) & (x <= 48))) {
    phase (pi);
  }
  control (((y >= 15) & (y <= 16)) & ((x >= 33) & (x <= 47))) {
    phase (pi);
  }
  control (((y >= 22) & (y <= 23)) & ((x >= 33) & (x <= 47))) {
    phase (pi);
  }
  control (((y >= 13) & (y <= 14)) & ((x >= 34) & (x <= 46))) {
    phase (pi);
  }
  control (((y >= 24) & (y <= 25)) & ((x >= 34) & (x <= 46))) {
    phase (pi);
  }
  control ((y == 12) & ((x >= 36) & (x <= 44))) {
    phase (pi);
  }
  control ((y == 26) & ((x >= 36) & (x <= 44))) {
    phase (pi);
  }
  control ((y == 11) & ((x >= 38) & (x <= 42))) {
    phase (pi);
  }
  control ((y == 27) & ((x >= 38) & (x <= 42))) {
    phase (pi);
  }
  control (((y >= 37) & (y <= 38)) & ((x >= 50) & (x <= 60))) {
    phase (pi);
  }
  control (((y >= 44) & (y <= 45)) & ((x >= 50) & (x <= 60))) {
    phase (pi);
  }
  control ((y == 36) & ((x >= 51) & (x <= 59))) {
    phase (pi);
  }
  control ((y == 46) & ((x >= 51) & (x <= 59))) {
    phase (pi);
  }
  control ((y == 35) & ((x >= 53) & (x <= 57))) {
    phase (pi);
  }
  control ((y == 47) & ((x >= 53) & (x <= 57))) {
    phase (pi);
  }
}

qfunc main(output x: qnum<6>, output y: qnum<6>) {
  allocate(x);
  allocate(y);
  hadamard_transform(x);
  hadamard_transform(y);
  logo_phase_oracle(x, y);
}

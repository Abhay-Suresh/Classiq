                }
              }
              control (y[1] == 0) {
                phase (pi);
              }
            }
          }
          control (y[3] == 0) {
            phase (pi);
          }
        }
        control (x[1] == 0) {
          control (x[2] == 0) {
            control (x[3] == 0) {
              control (x[0] == 0) {
                control (y[3] == 0) {
                  control (((y[2] == 0) & (y[0] == 0)) & (y[1] == 0)) {
                    phase (pi);
                  }
                  control (x[4] == 1) {
                    phase (pi);
                  }
                  control ((y[2] == 1) & (y[1] == 1)) {
                    phase (pi);
                  }
                }
              }
            }

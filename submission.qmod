qfunc logo_phase_oracle(const x: qnum, const y: qnum) {
  control ((((x >= 2) & (x <= 26)) & (y >= 29)) & (y <= 53)) {
    phase (pi);
  }
  control ((y >= 17) & (y <= 21)) {
    control (x == 32) {
      phase (pi);
    }
    control (x == 48) {
      phase (pi);
    }
  }
  control ((y >= 15) & (y <= 23)) {
    control (x == 33) {
      phase (pi);
    }
    control (x == 47) {
      phase (pi);
    }
  }
  control ((((x >= 27) & (x <= 61)) & (y >= 39)) & (y <= 43)) {
    phase (pi);
  }
  control ((x >= 36) & (x <= 44)) {
    control (y == 12) {
      phase (pi);
    }
    control (y == 26) {
      phase (pi);
    }
  }
  control ((x >= 38) & (x <= 42)) {
    control (y == 11) {
      phase (pi);
    }
    control (y == 27) {
      phase (pi);
    }
  }
  control ((((x >= 34) & (x <= 46)) & (y >= 13)) & (y <= 25)) {
    phase (pi);
  }
  control ((x >= 50) & (x <= 60)) {
    control (y == 37) {
      phase (pi);
    }
    control (y == 38) {
      phase (pi);
    }
    control (y == 44) {
      phase (pi);
    }
    control (y == 45) {
      phase (pi);
    }
  }
  control ((x >= 51) & (x <= 59)) {
    control (y == 36) {
      phase (pi);
    }
    control (y == 46) {
      phase (pi);
    }
  }
  control ((x >= 53) & (x <= 57)) {
    control (y == 35) {
      phase (pi);
    }
    control (y == 47) {
      phase (pi);
    }
  }
}

qfunc main(output x: qnum<6>, output y: qnum<6>) {
  allocate(x);
  allocate(y);
  hadamard_transform(x);
  hadamard_transform(y);
  logo_phase_oracle(x, y);
}
